{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Build, verify, and publish when a new version appears"
          },
          {
            "context": "Check the commits carry a sign-off"
          },
          {
            "context": "Check the ruleset names jobs that exist"
          }
        ]
      }
    }
  ]
}
